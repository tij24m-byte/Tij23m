{
  "entities": {
    "BankAccount": {
      "title": "BankAccount",
      "description": "Verified CBOS citizen bank account storing encrypted 512-number face fingerprint without raw selfie images.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "nationalId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9]+$"
        },
        "documentType": {
          "type": "string",
          "enum": ["national_id", "passport"]
        },
        "phone": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^\\+249[0-9]{9}$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "accountNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 24
        },
        "iban": {
          "type": "string",
          "minLength": 16,
          "maxLength": 34
        },
        "balance": {
          "type": "number"
        },
        "pinHash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "faceVectorHash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "faceVectorLength": {
          "type": "number"
        },
        "boundDeviceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "boundDeviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["active", "frozen"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "nationalId",
        "documentType",
        "phone",
        "email",
        "accountNumber",
        "iban",
        "balance",
        "pinHash",
        "faceVectorHash",
        "faceVectorLength",
        "boundDeviceId",
        "boundDeviceName",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "FaceRegistryEntry": {
      "title": "FaceRegistryEntry",
      "description": "Unique encrypted face vector index ensuring one account per human face.",
      "type": "object",
      "properties": {
        "faceVectorHash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "nationalIdHash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["faceVectorHash", "nationalIdHash", "ownerUid", "createdAt"]
    },
    "BankTransfer": {
      "title": "BankTransfer",
      "description": "Interbank or intra-CBOS transfer executed via QR, NFC, IBAN, or offline sync.",
      "type": "object",
      "properties": {
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "senderAccount": {
          "type": "string",
          "minLength": 8,
          "maxLength": 34
        },
        "receiverName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "receiverAccount": {
          "type": "string",
          "minLength": 8,
          "maxLength": 34
        },
        "receiverBankCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "receiverBankName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "channel": {
          "type": "string",
          "enum": ["QR", "NFC", "IBAN", "OFFLINE_QUEUE", "BILL"]
        },
        "routeType": {
          "type": "string",
          "enum": ["CBOS_INSTANT", "CENTRAL_BANK_SWITCH"]
        },
        "amount": {
          "type": "number"
        },
        "fee": {
          "type": "number"
        },
        "reference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "faceVerified": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "queued_offline"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "senderUid",
        "senderName",
        "senderAccount",
        "receiverName",
        "receiverAccount",
        "receiverBankCode",
        "receiverBankName",
        "channel",
        "routeType",
        "amount",
        "fee",
        "reference",
        "faceVerified",
        "status",
        "createdAt"
      ]
    },
    "WeeklyStatement": {
      "title": "WeeklyStatement",
      "description": "Automated Sunday 00:00 weekly PDF statement metadata per user.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "weekLabel": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80
        },
        "periodStart": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "periodEnd": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "openingBalance": {
          "type": "number"
        },
        "closingBalance": {
          "type": "number"
        },
        "transactionCount": {
          "type": "number"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "weekLabel",
        "periodStart",
        "periodEnd",
        "openingBalance",
        "closingBalance",
        "transactionCount",
        "issuedAt"
      ]
    },
    "FraudAlert": {
      "title": "FraudAlert",
      "description": "Blocked duplicate face registration or unauthorized biometric transfer attempt.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "channel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorUid", "reason", "channel", "createdAt"]
    },
    "DispatchLog": {
      "title": "DispatchLog",
      "description": "SMS and Email audit notification log for transfers, welcomes, and statements.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["SMS", "EMAIL"]
        },
        "recipient": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "body": {
          "type": "string",
          "minLength": 2,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "kind", "recipient", "subject", "body", "createdAt"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/BankAccount" },
      "description": "Citizen bank accounts strictly scoped to owner or CBOS admin."
    },
    "/faceRegistry/{faceKey}": {
      "schema": { "$ref": "#/entities/FaceRegistryEntry" },
      "description": "Encrypted face fingerprint uniqueness registry."
    },
    "/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/BankTransfer" },
      "description": "Completed and offline-synced CBOS and interbank switch transfers."
    },
    "/statements/{statementId}": {
      "schema": { "$ref": "#/entities/WeeklyStatement" },
      "description": "Weekly bank statement records generated for PDF export."
    },
    "/fraudAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/FraudAlert" },
      "description": "Blocked fraud and duplicate face attempts for CBOS Admin Dashboard."
    },
    "/notificationsLog/{logId}": {
      "schema": { "$ref": "#/entities/DispatchLog" },
      "description": "SMS and email notification audit logs."
    }
  }
}
